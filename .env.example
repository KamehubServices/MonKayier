# ==============================================================================
# MONKAYIER - ENVIRONNEMENT DE RÉFÉRENCE (.env.example)
# Porteur : KAMEHUB SERVICES SARL-U
# NOTE DE SÉCURITÉ : Aucun secret réel ne doit figurer dans ce fichier.
# ==============================================================================

APP_NAME=MONKAYIER
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# Contexte pays par défaut (TG = Togo)
DEFAULT_COUNTRY_CODE=TG

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de données PostgreSQL (Obligatoire V1)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=monkayier_db
DB_USERNAME=monkayier_user
DB_PASSWORD=secret_local_placeholder

# Base de données de test isolée
DB_TEST_DATABASE=monkayier_test_db

# Cache, Sessions & Queues (Redis)
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Stockage Objet compatible S3 (Fichiers, cours, justificatifs privés)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=monkayier-storage
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=

# Service d'envoi d'e-mails (Validation, notifications)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="support@monkayier.com"
MAIL_FROM_NAME="${APP_NAME}"

# Service IA & RAG (Service isolé pour éviter de bloquer le backend)
AI_SERVICE_ENABLED=true
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT_SECONDS=30
AI_MODEL_DEFAULT=mistral-7b-instruct
AI_RAG_MAX_CHUNKS=5
AI_RAG_SIMILARITY_THRESHOLD=0.72

# Paramètres de sécurité & Rate Limiting
AUTH_RATE_LIMIT_LOGIN_PER_MINUTE=5
AUTH_RATE_LIMIT_REGISTER_PER_MINUTE=3
API_RATE_LIMIT_STUDENT_PER_MINUTE=60
