# MonKayier - .gitignore
# Règles impératives de sécurité : Aucun secret, mot de passe ou fichier sensible dans Git.

# Environnements et secrets
.env
.env.backup
.env.production
.env.staging
.env.local
*.pem
*.key

# Dépendances
/vendor/
/node_modules/
package-lock.json.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Stockage et logs Laravel
/storage/*.key
/storage/app/private/*
!/storage/app/private/.gitkeep
/storage/app/public/*
!/storage/app/public/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep

# Builds et caches
/public/hot
/public/storage
/public/build
.phpunit.result.cache
.php-cs-fixer.cache

# Fichiers système et IDE
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*~

# Fichiers temporaires d'exécution de tests / scratch
/scratch/
/tmp/
/public/tts_cache/
check_dom_loaded.py
MonKayier.code-workspace
